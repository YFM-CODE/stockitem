<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Hentikan proses jika mengakses file atau folder fisik yang nyata ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Alihkan semua URL sisa ke file index.php dengan parameter query 'url'
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
